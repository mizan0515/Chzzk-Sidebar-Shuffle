{
  "manifest_version": 3,
  "name": "Chzzk Sidebar Shuffler",
  "version": "1.5.4",
  "description": "치지직 팔로잉 스트리머를 즐겨찾기, 티어, 셔플 기준으로 정렬합니다.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "clipboardWrite",
    "declarativeNetRequest",
    "notifications",
    "scripting",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://chzzk.naver.com/*",
    "https://api.chzzk.naver.com/*",
    "*://*.naver.com/*",
    "*://*.pstatic.net/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "commands": {
    "copy-timecode": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Copy the current Chzzk video timecode"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "exclude_matches": [
        "*://chzzk.naver.com/live/*/chat",
        "*://chzzk.naver.com/live/*/donation",
        "*://chzzk.naver.com/embed/*",
        "*://chzzk.naver.com/settings*"
      ],
      "js": [
        "js/logger.js",
        "js/platform.js",
        "js/domAdapter.js",
        "js/favoriteTierStore.js",
        "js/timecodeCore.js",
        "js/settings.js",
        "js/viewerCount.js",
        "js/moreButton.js",
        "js/star.js",
        "js/shuffle.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
